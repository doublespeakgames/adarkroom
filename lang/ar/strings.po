#: script/events/setpieces.js:2839 script/events/setpieces.js:2885
#: script/events/setpieces.js:2929
msgid "leave city"
msgstr "مغادرة المدينة"

#: script/events/setpieces.js:1281
msgid "orange traffic cones are set across the street, faded and cracked."
msgstr "مخاريط مرورية برتقالية موضوعة عبر الشارع، باهتة ومتشققة."

#: script/events/setpieces.js:1282
msgid "lights flash through the alleys between buildings."
msgstr "أضواء تومض عبر الأزقة بين المباني."

#: script/events/setpieces.js:1297
msgid "a large shanty town sprawls across the streets."
msgstr "مدينة صفيح كبيرة تمتد عبر الشوارع."

#: script/events/setpieces.js:1298
msgid "faces, darkened by soot and blood, stare out from crooked huts."
msgstr "وجوه، مسودة بالسخام والدم، تحدق من أكواخ ملتوية."

#: script/events/setpieces.js:1313
msgid "the shell of an abandoned hospital looms ahead."
msgstr "هيكل مستشفى مهجور يلوح أمامك."

#: script/events/setpieces.js:1329
msgid "the old tower seems mostly intact."
msgstr "البرج القديم يبدو سليماً إلى حد كبير."

#: script/events/setpieces.js:1330
msgid "the shell of a burned out car blocks the entrance."
msgstr "هيكل سيارة محترقة يحجب المدخل."

#: script/events/setpieces.js:1331
msgid "most of the windows at ground level are busted anyway."
msgstr "معظم النوافذ في الطابق الأرضي محطمة على أي حال."

#: script/events/setpieces.js:1346
msgid "a huge lizard scrambles up out of the darkness of an old metro station."
msgstr "سحلية ضخمة تتسلق من ظلام محطة مترو قديمة."

#: script/events/setpieces.js:1372
msgid "descend"
msgstr "النزول"

#: script/events/setpieces.js:1384
msgid "the shot echoes in the empty street."
msgstr "الطلقة تتردد في الشارع الفارغ."

#: script/events/setpieces.js:1424
msgid "the soldier steps out from between the buildings, rifle raised."
msgstr "الجندي يخطو من بين المباني، البندقية مرفوعة."

#: script/events/setpieces.js:1464
msgid "a frail man stands defiantly, blocking the path."
msgstr "رجل ضعيف يقف بتحدٍ، يحجب الطريق."

#: script/events/setpieces.js:1509
msgid "nothing but downcast eyes."
msgstr "لا شيء سوى عيون منكسرة."

#: script/events/setpieces.js:1510
msgid "the people here were broken a long time ago."
msgstr "الناس هنا انكسرت منذ زمن طويل."

#: script/events/setpieces.js:1525
msgid "empty corridors."
msgstr "ممرات فارغة."

#: script/events/setpieces.js:1526
msgid "the place has been swept clean by scavengers."
msgstr "المكان تم تنظيفه بالكامل من قبل النابشين."

#: script/events/setpieces.js:1540
msgid "an old man bursts through a door, wielding a scalpel."
msgstr "رجل عجوز ينفجر عبر الباب، يحمل مشرطاً."

#: script/events/setpieces.js:1579
msgid "a thug is waiting on the other side of the wall."
msgstr "رجل إجرامي ينتظر على الجانب الآخر من الجدار."

#: script/events/setpieces.js:1619
msgid "a snarling beast jumps out from behind a car."
msgstr "وحش هادر يقفز من خلف سيارة."

#: script/events/setpieces.js:1660
msgid "street above the subway platform is blown away."
msgstr "الشارع فوق منصة المترو منفجر."

#: script/events/setpieces.js:1661
msgid "lets some light down into the dusty haze."
msgstr "يسمح لبعض الضوء بالنزول إلى الضباب الغباري."

#: script/events/setpieces.js:1662
msgid "a sound comes from the tunnel, just ahead."
msgstr "صوت يأتي من النفق، أمامك مباشرة."

#: script/events/setpieces.js:1679
msgid "looks like a camp of sorts up ahead."
msgstr "يبدو وكأنه معسكر من نوع ما أمامك."

# a chainlink fence
#: script/events/setpieces.js:1681
msgid "rusted chainlink is pulled across an alleyway."
msgstr "سلسلة صدئة ممتدة عبر زقاق."

#: script/events/setpieces.js:1682
msgid "fires burn in the courtyard beyond."
msgstr "نيران تحترق في الفناء البعيد."

#: script/events/setpieces.js:1698
msgid "more voices can be heard ahead."
msgstr "المزيد من الأصوات يمكن سماعها أمامك."

#: script/events/setpieces.js:1699
msgid "they must be here for a reason."
msgstr "يجب أن يكونوا هنا لسبب ما."

#: script/events/setpieces.js:1715
msgid "the sound of gunfire carries on the wind."
msgstr "صوت إطلاق النار يحمله الريح."

#: script/events/setpieces.js:1716
msgid "the street ahead glows with firelight."
msgstr "الشارع أمامك يتوهج بضوء النار."

# define squatter
#: script/events/setpieces.js:1733
msgid "more squatters are crowding around now."
msgstr "المزيد من المستوطنين يتجمعون الآن."

#: script/events/setpieces.js:1734
msgid "someone throws a stone."
msgstr "شخص ما يرمي حجراً."

#: script/events/setpieces.js:1750
msgid "an improvised shop is set up on the sidewalk."
msgstr "متجر مؤقت منظم على الرصيف."

#: script/events/setpieces.js:1751
msgid "the owner stands by, stoic."
msgstr "المالك يقف بجانبه، متحمل."

#: script/events/setpieces.js:1796
msgid "strips of meat hang drying by the side of the street."
msgstr "شرائح من اللحم معلقة لتجف بجانب الشارع."

#: script/events/setpieces.js:1797
msgid "the people back away, avoiding eye contact."
msgstr "الناس يتراجعون، يتجنبون التواصل البصري."

#: script/events/setpieces.js:1822
msgid "someone has locked and barricaded the door to this operating theatre."
msgstr "شخص ما أغلق وحصن باب غرفة العمليات هذه."

# ward as part of the hospital?
#: script/events/setpieces.js:1837
msgid "a tribe of elderly squatters is camped out in this ward."
msgstr "قبيلة من المستوطنين المسنين معسكرة في هذا الجناح."

#: script/events/setpieces.js:1878
msgid "a pack of lizards rounds the corner."
msgstr "قطيع من السحالي يدور حول الزاوية."

# part of the hospital?
#: script/events/setpieces.js:1920
msgid "strips of meat are hung up to dry in this ward."
msgstr "شرائح من اللحم معلقة لتجف في هذا الجناح."

#: script/events/setpieces.js:1944
msgid "a large bird nests at the top of the stairs."
msgstr "طائر كبير يعشش في أعلى السلالم."

#: script/events/setpieces.js:1975
msgid "the debris is denser here."
msgstr "الحطام أكثر كثافة هنا."

#: script/events/setpieces.js:1976
msgid "maybe some useful stuff in the rubble."
msgstr "ربما بعض الأشياء المفيدة في الأنقاض."

#: script/events/setpieces.js:2015
msgid "a swarm of rats rushes up the tunnel."
msgstr "سرب من الجرذان يندفع عبر النفق."

#: script/events/setpieces.js:2051
msgid "a large man attacks, waving a bayonet."
msgstr "رجل كبير يهاجم، يلوح بسلاح حربة."

#: script/events/setpieces.js:2086
msgid "a second soldier opens fire."
msgstr "جندي ثانٍ يفتح النار."

#: script/events/setpieces.js:2127
msgid "a masked soldier rounds the corner, gun drawn"
msgstr "جندي مقنع يدور حول الزاوية، مسدسه مسلط"

#: script/events/setpieces.js:2168
msgid "the crowd surges forward."
msgstr "الحشد يندفع للأمام."

#: script/events/setpieces.js:2204
msgid "a youth lashes out with a tree branch."
msgstr "شاب يهاجم بغصن شجرة."

#: script/events/setpieces.js:2239
msgid "a squatter stands firmly in the doorway of a small hut."
msgstr "مستوطن يقف بثبات في مدخل كوخ صغير."

#: script/events/setpieces.js:2274
msgid "behind the door, a deformed figure awakes and attacks."
msgstr "خلف الباب، شخص مشوه يستيقظ ويهاجم."

#: script/events/setpieces.js:2314
msgid "as soon as the door is open a little bit, hundreds of tentacles erupt."
msgstr "بمجرد فتح الباب قليلاً، مئات من المجسات تنفجر."

#: script/events/setpieces.js:2341
msgid "bird must have liked shiney things."
msgstr "يجب أن الطائر كان يحب الأشياء اللامعة."

#: script/events/setpieces.js:2342
msgid "some good stuff woven into its nest."
msgstr "بعض الأشياء الجيدة منسوجة في عشه."

#: script/events/setpieces.js:2376
msgid "not much here."
msgstr "ليس الكثير هنا."

#: script/events/setpieces.js:2377
msgid "scavengers must have gotten to this place already."
msgstr "يجب أن النابشين وصلوا إلى هذا المكان بالفعل."

# part of the subway?
#: script/events/setpieces.js:2407
msgid "the tunnel opens up at another platform."
msgstr "النفق ينفتح على منصة أخرى."

#: script/events/setpieces.js:2408
msgid "the walls are scorched from an old battle."
msgstr "الجدران محترقة من معركة قديمة."

#: script/events/setpieces.js:2409
msgid "bodies and supplies from both sides litter the ground."
msgstr "جثث وإمدادات من كلا الجانبين متناثرة على الأرض."

#: script/events/setpieces.js:2453
msgid "the small military outpost is well supplied."
msgstr "المخفر العسكري الصغير مزود جيداً."

#: script/events/setpieces.js:2454
msgid ""
"arms and munitions, relics from the war, are neatly arranged on the "
"store-room floor."
msgstr ""
"zbraně a munice, coby relikvie války, jsou úhledně rozloženy po podlaze "
"zbrojnice."

#: script/events/setpieces.js:2455
msgid "just as deadly now as they were then."
msgstr "قاتلة الآن كما كانت حينها."

#: script/events/setpieces.js:2489
msgid "searching the bodies yields a few supplies."
msgstr "تفتيش الجثث يعطي بعض الإمدادات."

#: script/events/setpieces.js:2490
msgid "more soldiers will be on their way."
msgstr "المزيد من الجنود في الطريق."

#: script/events/setpieces.js:2491
msgid "time to move on."
msgstr "حان الوقت للمضي قدماً."

#: script/events/setpieces.js:2530
msgid "the small settlement has clearly been burning a while."
msgstr "المستوطنة الصغيرة تحترق بوضوح منذ فترة."

#: script/events/setpieces.js:2531
msgid ""
"the bodies of the wanderers that lived here are still visible in the "
"flames."
msgstr "جثث المتجولين الذين عاشوا هنا لا تزال مرئية في النيران."

#: script/events/setpieces.js:2532
msgid "still time to rescue a few supplies."
msgstr "لا يزال هناك وقت لإنقاذ بعض الإمدادات."

#: script/events/setpieces.js:2566
msgid "the remaining settlers flee from the violence, their belongings forgotten."
msgstr "المستوطنون المتبقون يفرون من العنف، ممتلكاتهم منسية."

#: script/events/setpieces.js:2567
msgid "there's not much, but some useful things can still be found."
msgstr "ليس هناك الكثير، لكن لا يزال يمكن العثور على بعض الأشياء المفيدة."

#: script/events/setpieces.js:2601
msgid "the young settler was carrying a canvas sack."
msgstr "المستوطن الشاب كان يحمل كيس قماش."

#: script/events/setpieces.js:2602
msgid "it contains travelling gear, and a few trinkets."
msgstr "يحتوي على معدات السفر، وبعض الحلي."

#: script/events/setpieces.js:2603 script/events/setpieces.js:2639
msgid "there's nothing else here."
msgstr "لا يوجد شيء آخر هنا."

#: script/events/setpieces.js:2637
msgid "inside the hut, a child cries."
msgstr "داخل الكوخ، طفل يبكي."

#: script/events/setpieces.js:2638
msgid "a few belongings rest against the walls."
msgstr "بعض الممتلكات تستند على الجدران."

#: script/events/setpieces.js:2678
msgid "the stench of rot and death fills the operating theatres."
msgstr "رائحة التعفن والموت تملأ غرف العمليات."

#: script/events/setpieces.js:2679
msgid "a few items are scattered on the ground."
msgstr "بعض العناصر متناثرة على الأرض."

#: script/events/setpieces.js:2680
msgid "there is nothing else here."
msgstr "لا يوجد شيء آخر هنا."

#: script/events/setpieces.js:2719
msgid "a pristine medicine cabinet at the end of a hallway."
msgstr "خزانة دواء نظيفة في نهاية الممر."

#: script/events/setpieces.js:2720
msgid "the rest of the hospital is empty."
msgstr "بقية المستشفى فارغة."

#: script/events/setpieces.js:2754
msgid "someone had been stockpiling loot here."
msgstr "شخص ما كان يخزن الغنائم هنا."

#: script/events/setpieces.js:2803
msgid "the tentacular horror is defeated."
msgstr "الرعب ذو المجسات هُزم."

#: script/events/setpieces.js:2804
msgid "inside, the remains of its victims are everywhere."
msgstr "في الداخل، بقايا ضحاياه في كل مكان."

# extremly disfigured
#: script/events/setpieces.js:2849
msgid "the warped man lies dead."
msgstr "الرجل المشوه ميت."

#: script/events/setpieces.js:2850
msgid "the operating theatre has a lot of curious equipment."
msgstr "غرفة العمليات لديها الكثير من المعدات الغريبة."

#: script/events/setpieces.js:2894
msgid "the old man had a small cache of interesting items."
msgstr "الرجل العجوز كان لديه مخبأ صغير من العناصر المثيرة للاهتمام."

#: script/events/setpieces.js:2939
msgid "An Old House"
msgstr "منزل قديم"

#: script/events/setpieces.js:2943
msgid "an old house remains here, once white siding yellowed and peeling."
msgstr "منزل قديم يبقى هنا، واجهته البيضاء ذات مرة صفراء ومتقشرة."

#: script/events/setpieces.js:2944
msgid "the door hangs open."
msgstr "الباب معلق مفتوحاً."

#: script/events/setpieces.js:2946
msgid "the remains of an old house stand as a monument to simpler times"
msgstr "بقايا منزل قديم تقف كنصب تذكاري لأوقات أبسط"

#: script/events/setpieces.js:2960
msgid "the house is abandoned, but not yet picked over."
msgstr "المنزل مهجور، لكن لم يتم نهبه بعد."

#: script/events/setpieces.js:2961
msgid "still a few drops of water in the old well."
msgstr "لا يزال هناك بضع قطرات من الماء في البئر القديم."

#: script/events/setpieces.js:2995
msgid "the house has been ransacked."
msgstr "المنزل تم نهبه."

#: script/events/setpieces.js:2996
msgid "but there is a cache of medicine under the floorboards."
msgstr "لكن هناك مخبأ من الدواء تحت الألواح."

#: script/events/setpieces.js:3024
msgid "a man charges down the hall, a rusty blade in his hand"
msgstr "رجل يندفع عبر القاعة، نصل صدئ في يده"

#: script/events/setpieces.js:3057
msgid "A Forgotten Battlefield"
msgstr "ساحة معركة منسية"

#: script/events/setpieces.js:3061
msgid "a battle was fought here, long ago."
msgstr "معركة دارت هنا، منذ زمن طويل."

#: script/events/setpieces.js:3062
msgid "battered technology from both sides lays dormant on the blasted landscape."
msgstr ""
"pomlácené vybavení obou stran se nehybně povaluje po rozbombardované "
"krajině."

#: script/events/setpieces.js:3111
msgid "A Huge Borehole"
msgstr "بئر حفر ضخم"

#: script/events/setpieces.js:3115
msgid "a huge hole is cut deep into the earth, evidence of the past harvest."
msgstr "حفرة ضخمة مقطوعة بعمق في الأرض، دليل على الحصاد الماضي."

#: script/events/setpieces.js:3116
msgid "they took what they came for, and left."
msgstr "أخذوا ما جاءوا من أجله، وغادروا."

#: script/events/setpieces.js:3117
msgid ""
"castoff from the mammoth drills can still be found by the edges of the "
"precipice."
msgstr "بقايا من الحفارات الضخمة لا تزال يمكن العثور عليها عند حواف الجرف."

#: script/events/setpieces.js:3141
msgid "A Crashed Ship"
msgstr "سفينة محطمة"

#: script/events/setpieces.js:3150
msgid "the familiar curves of a wanderer vessel rise up out of the dust and ash. "
msgstr "المنحنيات المألوفة لسفينة متجول ترتفع من الغبار والرماد. "

#: script/events/setpieces.js:3151
msgid "lucky that the natives can't work the mechanisms."
msgstr "محظوظ أن السكان الأصليين لا يستطيعون تشغيل الآليات."

#: script/events/setpieces.js:3152
msgid "with a little effort, it might fly again."
msgstr "بقليل من الجهد، قد تطير مرة أخرى."

#: script/events/setpieces.js:3156
msgid "salvage"
msgstr "إنقاذ"

#: script/events/setpieces.js:3165
msgid "The Sulphur Mine"
msgstr "منجم الكبريت"

#: script/events/setpieces.js:3169
msgid "the military is already set up at the mine's entrance."
msgstr "الجيش منظم بالفعل عند مدخل المنجم."

#: script/events/setpieces.js:3170
msgid "soldiers patrol the perimeter, rifles slung over their shoulders."
msgstr "جنود يطوفون المحيط، بنادق معلقة على أكتافهم."

#: script/events/setpieces.js:3172
msgid "a military perimeter is set up around the mine."
msgstr "محيط عسكري منظم حول المنجم."

#: script/events/setpieces.js:3175 script/events/setpieces.js:3325
msgid "attack"
msgstr "هجوم"

#: script/events/setpieces.js:3210
msgid "a soldier, alerted, opens fire."
msgstr "جندي، متنبه، يفتح النار."

#: script/events/setpieces.js:3218 script/events/setpieces.js:3258
#: script/events/setpieces.js:3362 script/events/setpieces.js:3396
msgid "run"
msgstr "هرب"

#: script/events/setpieces.js:3250
msgid "a second soldier joins the fight."
msgstr "جندي ثانٍ ينضم للقتال."

#: script/events/setpieces.js:3284
msgid "a grizzled soldier attacks, waving a bayonet."
msgstr "جندي أشيب يهاجم، يلوح بسلاح حربة."

#: script/events/setpieces.js:3295
msgid "the military presence has been cleared."
msgstr "الوجود العسكري تم تطهيره."

#: script/events/setpieces.js:3296 script/events/setpieces.js:3439
#: script/events/setpieces.js:3516
msgid "the mine is now safe for workers."
msgstr "المنجم آمن الآن للعمال."

#: script/events/setpieces.js:3298
msgid "the sulphur mine is clear of dangers"
msgstr "منجم الكبريت خالٍ من الأخطار"

#: script/events/setpieces.js:3315
msgid "The Coal Mine"
msgstr "منجم الفحم"

#: script/events/setpieces.js:3319
msgid "camp fires burn by the entrance to the mine."
msgstr "نيران المعسكر تحترق عند مدخل المنجم."

#: script/events/setpieces.js:3320
msgid "men mill about, weapons at the ready."
msgstr "رجال يتجولون، أسلحتهم جاهزة."

#: script/events/setpieces.js:3322
msgid "this old mine is not abandoned"
msgstr "هذا المنجم القديم ليس مهجوراً"

#: script/events/setpieces.js:3354 script/events/setpieces.js:3388
msgid "a man joins the fight"
msgstr "رجل ينضم للقتال"

#: script/events/setpieces.js:3427
msgid "only the chief remains."
msgstr "الزعيم فقط يبقى."

#: script/events/setpieces.js:3438
msgid "the camp is still, save for the crackling of the fires."
msgstr "المعسكر هادئ، باستثناء طقطقة النيران."

#: script/events/setpieces.js:3441
msgid "the coal mine is clear of dangers"
msgstr "منجم الفحم خالٍ من الأخطار"

#: script/events/setpieces.js:3458
msgid "The Iron Mine"
msgstr "منجم الحديد"

#: script/events/setpieces.js:3462
msgid "an old iron mine sits here, tools abandoned and left to rust."
msgstr ""
"před tebou se rozkládá starý železorudný důl obklopený rezavějícími "
"nástroji."

#: script/events/setpieces.js:3463
msgid ""
"bleached bones are strewn about the entrance. many, deeply scored with "
"jagged grooves."
msgstr "عظام مبيضة متناثرة حول المدخل. الكثير منها، محفورة بعمق بأخاديد خشنة."

#: script/events/setpieces.js:3464
msgid "feral howls echo out of the darkness."
msgstr "عويل متوحش يتردد من الظلام."

#: script/events/setpieces.js:3466
msgid "the path leads to an abandoned mine"
msgstr "الطريق يؤدي إلى منجم مهجور"

#: script/events/setpieces.js:3504
msgid "a large creature lunges, muscles rippling in the torchlight"
msgstr "مخلوق كبير يندفع، عضلاته تتمايل في ضوء المشعل"

#: script/events/setpieces.js:3515
msgid "the beast is dead."
msgstr "الوحش ميت."

#: script/events/setpieces.js:3518
msgid "the iron mine is clear of dangers"
msgstr "منجم الحديد خالٍ من الأخطار"

#: script/events/setpieces.js:3536
msgid "A Destroyed Village"
msgstr "قرية مدمرة"

#: script/events/setpieces.js:3540
msgid "a destroyed village lies in the dust."
msgstr "قرية مدمرة تقع في الغبار."

#: script/events/setpieces.js:3541
msgid "charred bodies litter the ground."
msgstr "جثث محترقة متناثرة على الأرض."

# afterburner: an engine
#: script/events/setpieces.js:3544
msgid "the metallic tang of wanderer afterburner hangs in the air."
msgstr "الطعم المعدني لعادم محرك المتجول معلق في الهواء."

#: script/events/setpieces.js:3558
msgid "a shack stands at the center of the village."
msgstr "كوخ يقف في وسط القرية."

#: script/events/setpieces.js:3559
msgid "there are still supplies inside."
msgstr "لا تزال هناك إمدادات في الداخل."

#: script/events/setpieces.js:3570
msgid "all the work of a previous generation is here."
msgstr "كل عمل الجيل السابق هنا."

#: script/events/setpieces.js:3571
msgid "ripe for the picking."
msgstr "ناضج للقطف."

#~ msgid "use with laser rifle"
#~ msgstr "použít s laserovou puškou"

